# Скопируйте в .env и заполните:  cp .env.example .env
# .env не коммитится. Обязателен только GROQ_API_KEY; GITHUB_TOKEN нужен для режима GitHub,
# остальное — по желанию.

# Адрес, по которому открывается сайт (используется в ссылках из Telegram)
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# --- Groq (https://console.groq.com -> API Keys) ---
GROQ_API_KEY=
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=qwen/qwen3.8-27b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# --- GitHub (fine-grained token: Contents, Pull requests, Issues = RW; Actions = R) ---
GITHUB_TOKEN=
# Репозитории, в которых агент следит за issue с меткой ISSUE_LABEL (через запятую)
WATCHED_REPOS=
ISSUE_LABEL=bug
ISSUE_POLL_INTERVAL=60
# true — при старте взять и issue за последние 7 дней
ISSUE_BACKFILL=false
# Нужен только для вебхука /api/v1/webhooks/github (когда есть публичный адрес)
GITHUB_WEBHOOK_SECRET=

# --- Telegram (необязательно; @BotFather -> /newbot) ---
TELEGRAM_BOT_TOKEN=
# Необязательно: бот сам запоминает chat ID по команде /start. Здесь можно закрепить чат для запусков из issue.
TELEGRAM_DEFAULT_CHAT_ID=

# --- Агент ---
MAX_FIX_ATTEMPTS=3
AGENT_MAX_ITERATIONS=6
CI_POLL_INTERVAL=20
CI_TIMEOUT=600
CI_NO_RUNS_GRACE=90

# --- Песочница для тестов (Docker) ---
SANDBOX_ENABLED=true
SANDBOX_IMAGE=python:3.12-slim
SANDBOX_TEST_TIMEOUT=180

# --- Локальный режим (без GitHub) ---
# Папка на компьютере с git-проектами; в форме указывайте local:<имя папки>.
# Агент создаёт в проекте ветку ai-fix/..., рабочие файлы не меняет.
LOCAL_PROJECTS_DIR=./local-projects

# --- LangSmith (https://smith.langchain.com -> Settings -> API Keys) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-bug-investigator
